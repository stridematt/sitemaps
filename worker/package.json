{
  "name": "rtt-hreflang",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "mkdir -p dist && cp deploy/rtt-hreflang.min.js dist/index.js && node test/test.mjs",
    "deploy": "wrangler deploy",
    "bundle": "esbuild src/index.js --bundle --format=esm --minify --legal-comments=none --outfile=deploy/rtt-hreflang.min.js && node scripts/oneline.mjs",
    "bundle:sqsp": "esbuild src/sqsp.js --bundle --format=iife --global-name=RTTSync --legal-comments=none --outfile=../tools/sqsp/rtt-sqsp-sync.js",
    "test:sqsp": "node test/sqsp.test.mjs",
    "test:sitemap": "node test/sitemap.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
